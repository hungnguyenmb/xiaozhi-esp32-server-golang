FROM python:3.12-slim AS runtime
ENV PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1 HF_HUB_OFFLINE=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.phowhisper.txt .
RUN pip install --no-cache-dir -r requirements.phowhisper.txt
COPY phowhisper_bridge.py prepare_phowhisper.py phowhisper-manifest.json ./
USER 10001:10001
CMD ["python", "phowhisper_bridge.py"]

FROM runtime AS converter
USER root
ENV HF_HUB_OFFLINE=0 HF_HOME=/tmp/huggingface HF_HUB_ETAG_TIMEOUT=60 HF_HUB_DOWNLOAD_TIMEOUT=120
RUN pip install --no-cache-dir torch==2.8.0 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir transformers==4.55.4
ENTRYPOINT ["python", "prepare_phowhisper.py", "convert"]
